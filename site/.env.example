# Copy to .env for local testing with `vercel dev` (plain `vite dev` does not
# run /api routes). Never commit the real .env file.

# The Gmail (or Google Workspace) address that authenticates and sends the
# mail. Requires 2-Step Verification + an App Password — see site/README.md.
GMAIL_USER=youraddress@gmail.com

# The 16-character App Password generated for that account (no spaces).
GMAIL_APP_PASSWORD=

# Where contact-form messages are delivered. Optional — defaults to GMAIL_USER
# if omitted, so only set this if you want mail sent to a different inbox.
CONTACT_TO=authorservices@page-and-pixel.com
